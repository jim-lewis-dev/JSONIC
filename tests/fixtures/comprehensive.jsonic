/* prefix block comment */
{
    '''triple prefix'''
    // line prefix
    "title"   /*c1*/ : /*c3*/ "JSONIC torture test: strings have /*not comments*/ and //not comments and '''not comments'''",
    "escapes" : "quote=\" backslash=\\ slash=/ newline=\\n tab=\\t uni=\\u263A end",
    "numbers" : [
        /* X0 */ 0,
        -0,
        1,
        -1,
        3.14159,
        -2.5e-2,
        6.022E23,
        1000000000,
        0.0000001 /* after elem comment */
        // tail comment after last element (no trailing comma)
    ],

    "bools_nulls" : [ true,false,null /*tail*/ ],

    "empty_things" : {
        "empty_obj" : {   /* inside empty obj */   },
        "empty_arr" : [   ''' inside empty arr '''   ],
        "empty_arr2": [/*x*/]
    },

    "array_of_objects" : [
        { "k": "v", "n": 1, "b": true, "z": null },
        {
            /* comment between members */
            "nested" : {
                "a" : [ 1,2,3 ],
                "b" : [ /*ws*/ ],
                "c" : { }
            },
            "weird_string" : "text: ] } , : // /* ''' still just text",
            "deep" : [
                { "i":0, "x":[10,20,30] },
                { "i":1, "x":[ ] },
                { "i":2, "x":[ "a", "b", "c" ] }
            ]
        },
        { "last": true }  // comment right before closing bracket of array_of_objects
    ],

    "mixed_array" : [
        "first"  ,/* comment before comma? no: this is after element */  2,
        3,
        /* block between comma and next element */
        4,
        [ "inner0", "inner1", { "inner_obj": [null,true,false] } ],
        { "obj_in_array" : [ { "a":1 }, { "b":2 } ] }
        // end comment for mixed_array
    ],

    "object_with_spacing" /*c1*/ : /*c3*/ {
        "a"/*c2*/:/*c3*/1/*c4*/,
        "b" : [ 1 , 2 , 3 ],
        "c" : {
            "d" : "e"
        }
    } /* trailing obj comment */
}
/* suffix block comment */

